$C = "../../Common.ui";
$T = "NexoriTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1180, Height: 720);

  #Title {
    Group {
      $C.@Title {
        @Text = "NEXORI TARGET";
      }

      Group {
        LayoutMode: Top;

        Label {
          Text: "Step-by-step destination target creation using your current in-game world, position, and facing direction.";
          Style: (TextColor: $T.@BodyText);
        }
      }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Full: 14);

    Group {
      Padding: (Full: 16);
      Background: $T.@MenuPanelBg;
      LayoutMode: Top;

      Label #StatusText {
        Text: "";
        Visible: false;
        Style: (TextColor: $T.@BodyText);
      }

      Group { Anchor: (Height: 10); }

      Group {
        LayoutMode: Left;

        Label #StepProgressText {
          Text: "Step 1 of 3";
          Style: (RenderBold: true, TextColor: $T.@StrongText);
        }

        Group { Anchor: (Width: 10); }

        Label #StepTitleText {
          Text: "";
          Style: (TextColor: $T.@PrimaryText);
        }
      }

      Group { Anchor: (Height: 18); }

      Group #KindStep {
        LayoutMode: Top;

        Label {
          Text: "Target Kind";
          Style: (RenderBold: true, TextColor: $T.@StrongText);
        }

        Group { Anchor: (Height: 8); }

        Label #SelectedKindText {
          Text: "";
          Style: (TextColor: $T.@PrimaryText);
        }

        Group { Anchor: (Height: 6); }

        Label #SelectedKindMetaText {
          Text: "";
          Style: (TextColor: $T.@MutedText);
        }

        Group { Anchor: (Height: 14); }

        Group {
          LayoutMode: Left;

          Button #KindPrevButton {
            Anchor: (Width: 88);
            Padding: (Left: 14, Right: 14, Top: 8, Bottom: 8);
            Background: $T.@TabInactiveBg;
            Label { Text: "Prev"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
          }

          Group { Anchor: (Width: 8); }

          Button #KindNextButton {
            Anchor: (Width: 88);
            Padding: (Left: 14, Right: 14, Top: 8, Bottom: 8);
            Background: $T.@TabActiveBg;
            Label { Text: "Next"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
          }
        }
      }

      Group #DetailsStep {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: "Display Name";
          Style: (RenderBold: true, TextColor: $T.@StrongText);
        }

        Group { Anchor: (Height: 8); }

        Group #DisplayNameField {
          LayoutMode: Left;
          TextField #Input {
            Anchor: (Width: 360, Height: 36);
            Padding: (Left: 8);
            Style: (FontSize: 16);
            PlaceholderText: "display name";
            PlaceholderStyle: (FontSize: 13, TextColor: #667488);
            Background: #0F0F1A;
            MaxLength: 160;
            Value: "";
          }
        }

        Group { Anchor: (Height: 10); }

        Label #DetailsHintText {
          Text: "";
          Style: (TextColor: $T.@MutedText);
        }
      }

      Group #ReviewStep {
        LayoutMode: Top;
        Visible: false;

        Group {
          LayoutMode: Left;
          Label { Text: "World:"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
          Group { Anchor: (Width: 8); }
          Label #ReviewWorldText { Text: ""; Style: (TextColor: $T.@PrimaryText); }
        }

        Group { Anchor: (Height: 6); }

        Group {
          LayoutMode: Left;
          Label { Text: "Display Name:"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
          Group { Anchor: (Width: 8); }
          Label #ReviewDisplayNameText { Text: ""; Style: (TextColor: $T.@PrimaryText); }
        }

        Group { Anchor: (Height: 6); }

        Group {
          LayoutMode: Left;
          Label { Text: "Kind:"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
          Group { Anchor: (Width: 8); }
          Label #ReviewKindText { Text: ""; Style: (TextColor: $T.@PrimaryText); }
        }

        Group { Anchor: (Height: 12); }

        Label #ReviewCaptureText {
          Text: "";
          Style: (TextColor: $T.@MutedText);
        }
      }

      Group { Anchor: (Height: 18); }

      Group {
        LayoutMode: Left;

        Button #ResetButton {
          Anchor: (Width: 104);
          Padding: (Left: 14, Right: 14, Top: 8, Bottom: 8);
          Background: $T.@TabInactiveBg;
          Label { Text: "Reset"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
        }

        Group { Anchor: (Width: 8); }

        Button #PrevStepButton {
          Anchor: (Width: 104);
          Padding: (Left: 14, Right: 14, Top: 8, Bottom: 8);
          Background: $T.@TabInactiveBg;
          Label { Text: "Back"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
        }

        Group { Anchor: (Width: 8); }

        Button #NextStepButton {
          Anchor: (Width: 104);
          Padding: (Left: 14, Right: 14, Top: 8, Bottom: 8);
          Background: $T.@TabActiveBg;
          Label { Text: "Next"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
        }

        Group { Anchor: (Width: 8); }

        Button #SaveTargetButton {
          Anchor: (Width: 120);
          Padding: (Left: 14, Right: 14, Top: 8, Bottom: 8);
          Background: $T.@TabActiveBg;
          Visible: false;
          Label { Text: "Save Target"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
        }
      }
    }
  }
}

$C.@BackButton {}
