$T = "NexoriTheme.ui";

Group #TargetsBody {
  LayoutMode: Top;
  Padding: (Full: 12);
  Background: $T.@MenuPanelBg;

  Label {
    Text: "TARGETS";
    Style: (RenderBold: true, TextColor: $T.@StrongText);
  }

  Group {
    Anchor: (Height: 10);
  }

  Label #TargetsSummaryText {
    Text: "";
    Style: (TextColor: $T.@BodyText);
  }

  Group {
    Anchor: (Height: 8);
  }

  Label #TargetsDetailText {
    Text: "";
    Style: (TextColor: $T.@MutedText);
  }

  Group {
    Anchor: (Height: 14);
  }

  Button #OpenTargetManagerButton {
    Anchor: (Width: 196);
    Padding: (Left: 14, Right: 14, Top: 8, Bottom: 8);
    Background: $T.@TabActiveBg;
    Style: (
      Hovered: (
        Background: $T.@ActionHoverBg,
      ),
      Pressed: (
        Background: $T.@ActionPressedBg,
      )
    );

    Label {
      Text: "Open Target Manager";
      Style: (RenderBold: true, TextColor: $T.@StrongText);
    }
  }
}
