$C = "../../Common.ui";
$T = "NexoriTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1480, Height: 780);

  #Title {
    Group {
      $C.@Title {
        @Text = "NEXORI RECOVERY";
      }

      Group {
        LayoutMode: Top;

        Label {
          Text: "Review your recent inventory transfer backups and try recovery when a server-to-server transfer did not finish the way you expected.";
          Style: (TextColor: $T.@BodyText);
        }
      }
    }
  }

  #Content {
    LayoutMode: Left;
    Padding: (Full: 12);

    Group #RecoveryColumn {
      FlexWeight: 5;
      LayoutMode: Top;
      Padding: (Full: 12);
      Background: $T.@MenuPanelBg;

      Label {
        Text: "RECENT BACKUPS";
        Style: (RenderBold: true, TextColor: $T.@StrongText);
      }

      Group { Anchor: (Height: 6); }

      Label #BackupCountText {
        Text: "0 recoverable backup(s)";
        Style: (TextColor: $T.@MutedText);
      }

      Group { Anchor: (Height: 8); }

      Label #StatusText {
        Text: "";
        Visible: false;
        Style: (TextColor: $T.@BodyText);
      }

      Group { Anchor: (Height: 8); }

      Label #EmptyHint {
        Text: "";
        Visible: false;
        Style: (TextColor: $T.@MutedText);
      }

      Group { Anchor: (Height: 12); }

      Group #RecoveryList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        KeepScrollPosition: true;
      }
    }

    Group { Anchor: (Width: 16); }

    Group #DetailsColumn {
      FlexWeight: 4;
      LayoutMode: Top;
      Padding: (Full: 12);
      Background: $T.@MenuPanelBg;

      Label {
        Text: "BACKUP DETAILS";
        Style: (RenderBold: true, TextColor: $T.@StrongText);
      }

      Group { Anchor: (Height: 12); }

      Group {
        LayoutMode: Left;
        Label { Text: "Transfer ID:"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
        Group { Anchor: (Width: 8); }
        Label #SelectedTransferId { Text: "<none>"; Style: (TextColor: $T.@PrimaryText); }
      }

      Group { Anchor: (Height: 6); }

      Group {
        LayoutMode: Left;
        Label { Text: "Created:"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
        Group { Anchor: (Width: 8); }
        Label #SelectedCreatedAt { Text: "<none>"; Style: (TextColor: $T.@PrimaryText); }
      }

      Group { Anchor: (Height: 6); }

      Group {
        LayoutMode: Left;
        Label { Text: "Destination:"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
        Group { Anchor: (Width: 8); }
        Label #SelectedDestination { Text: "<none>"; Style: (TextColor: $T.@PrimaryText); }
      }

      Group { Anchor: (Height: 6); }

      Group {
        LayoutMode: Left;
        Label { Text: "Target:"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
        Group { Anchor: (Width: 8); }
        Label #SelectedTarget { Text: "<none>"; Style: (TextColor: $T.@PrimaryText); }
      }

      Group { Anchor: (Height: 6); }

      Group {
        LayoutMode: Left;
        Label { Text: "Travel Profile:"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
        Group { Anchor: (Width: 8); }
        Label #SelectedProfile { Text: "<none>"; Style: (TextColor: $T.@PrimaryText); }
      }

      Group { Anchor: (Height: 14); }

      Label {
        Text: "Inventory Summary";
        Style: (RenderBold: true, TextColor: $T.@StrongText);
      }

      Group { Anchor: (Height: 8); }

      Group {
        LayoutMode: Left;
        Label { Text: "Inventory:"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
        Group { Anchor: (Width: 8); }
        Label #SelectedInventoryCount { Text: "<none>"; Style: (TextColor: $T.@PrimaryText); }
      }

      Group { Anchor: (Height: 18); }

      Label #SelectedRecoveryHint {
        Text: "";
        Style: (TextColor: $T.@MutedText);
      }

      Group { Anchor: (Height: 18); }

      Button #TryRecoverButton {
        Anchor: (Width: 170);
        Padding: (Left: 14, Right: 14, Top: 8, Bottom: 8);
        Background: $T.@TabActiveBg;
        Visible: false;
        Label #TryRecoverButtonLabel { Text: "Try Recover"; Style: (RenderBold: true, TextColor: $T.@StrongText); }
      }
    }
  }
}

$C.@BackButton {}
